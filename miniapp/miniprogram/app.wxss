page {
  --bg: #f2f2f7;
  --surface: #fff;
  --fg: #161619;
  --sub: #595962;
  --border: #d8d8de;
  --blue: #005fc7;
  --tint: #e8f2ff;
  --chrome: rgba(250, 250, 253, 0.96);
  --error: #b32723;
  color: var(--fg);
  background: var(--bg);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.45;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg: #161618;
    --surface: #242427;
    --fg: #f7f7fa;
    --sub: #b6b6bf;
    --border: #454548;
    --blue: #80bcff;
    --tint: #243647;
    --chrome: rgba(34, 34, 37, 0.96);
    --error: #ff8a85;
  }
}
.page {
  padding: 12px 16px 32px;
  max-width: 760px;
  margin: auto;
  box-sizing: border-box;
}
.with-tabs {
  padding-bottom: calc(86px + env(safe-area-inset-bottom));
}
.title {
  font-size: 1.95em;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -0.04em;
  margin: 10px 0 21px;
}
.caption {
  font-size: 0.8em;
  color: var(--sub);
  margin: 22px 13px 7px;
}
.group {
  border-radius: 15px;
  background: var(--surface);
  overflow: hidden;
}
.row,
.action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 12px 16px;
  text-align: left;
  font: inherit;
  line-height: 1.45;
  color: var(--fg);
  background: var(--surface);
  border: 0;
  margin: 0;
  border-radius: 0;
}
.row + .row,
.action + .action,
.row + .action {
  border-top: 1px solid var(--border);
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.55;
}
button:active {
  opacity: 0.72;
}
.grow {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.strong {
  font-weight: 600;
}
.sub,
.note {
  color: var(--sub);
  font-size: 0.87em;
}
.note,
.error {
  margin: 10px 12px;
  overflow-wrap: anywhere;
}
.error {
  color: var(--error);
}
.chev {
  color: var(--sub);
  font-size: 1.22em;
}
.accent,
.action {
  color: var(--blue);
}
.primary {
  font: inherit;
  line-height: 1.45;
  color: white;
  background: #0063cf;
  border-radius: 13px;
  min-height: 48px;
  padding: 12px 18px;
  margin: 14px 0;
}
.input {
  box-sizing: border-box;
  min-height: 48px;
  padding: 8px 12px;
  color: var(--fg);
  background: var(--bg);
  border-radius: 10px;
  width: 100%;
  font: inherit;
}
.pad {
  padding: 16px;
}
.big {
  font-size: 2.05em;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.inline {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.control {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48px;
  min-height: 48px;
  font: inherit;
  color: var(--blue);
  background: transparent;
  padding: 4px 10px;
  margin: 0;
  border-radius: 10px;
  line-height: 1.3;
}
.section {
  margin-top: 14px;
}
.bodytext {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.thread {
  flex: 1;
  min-height: 0;
}
.bar {
  background: var(--chrome);
  border-top: 1px solid var(--border);
  padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
}
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 5;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 78vh;
  background: var(--surface);
  border-radius: 20px 20px 0 0;
  padding: 14px 16px calc(18px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-scroll {
  max-height: 59vh;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.head .strong {
  font-size: 1.2em;
}
