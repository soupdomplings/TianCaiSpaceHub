<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="TianCaiSpaceHub"
    Manufacturer="TianCaiSpaceHub"
    Version="$(var.ProductVersion)"
    Language="1033"
    Codepage="936"
    UpgradeCode="{42B4BF3C-E660-4C83-96AA-56A4426B96A2}"
    Scope="perMachine"
    Compressed="yes">
    <!-- Remove the old layout before installing renamed files, within the rollback transaction. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="TianCaiSpaceHubIcon" SourceFile="$(var.SourceDir)\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="TianCaiSpaceHubIcon" />

    <!-- Preserve the existing ProductLanguage/upgrade match; zh-CN resources control the UI text. -->
    <!-- A user-selected launch belongs only to the successful full-UI exit page. -->
    <Property Id="WixUnelevatedShellExecTarget" Value="[#TianCaiSpaceHubExe]" />
    <CustomAction
      Id="OpenTianCaiSpaceHub"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixUnelevatedShellExec"
      Execute="immediate"
      Return="ignore" />

    <!-- Common dialogs supply progress, errors and cancellation without adding a license/welcome wizard. -->
    <UIRef Id="WixUI_Common" />
    <UI Id="TianCaiSpaceHubUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="10" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="TianCaiSpaceHubSuccessDlg" Width="370" Height="180" Title="[ProductName] 安装程序">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="25" NoPrefix="yes" Text="{\WixUI_Font_Bigger}安装成功" />
        <Control Id="Description" Type="Text" X="20" Y="55" Width="330" Height="55" NoPrefix="yes" Text="TianCaiSpaceHub 已安装成功。点击“打开 TianCaiSpaceHub”立即使用，或点击“完成”关闭安装程序。" />
        <Control Id="BottomLine" Type="Line" X="0" Y="135" Width="370" Height="0" />
        <Control Id="Open" Type="PushButton" X="20" Y="150" Width="220" Height="20" Text="打开 TianCaiSpaceHub">
          <Publish Event="DoAction" Value="OpenTianCaiSpaceHub" Order="1" Condition="UILevel = 5 AND NOT Installed AND NOT REMOVE AND NOT REINSTALL AND NOT UPGRADINGPRODUCTCODE AND &amp;MainFeature = 3" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Finish" Type="PushButton" X="275" Y="150" Width="75" Height="20" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="TianCaiSpaceHubSuccessDlg" OnExit="success" Condition="UILevel = 5 AND NOT Installed AND NOT REMOVE AND NOT REINSTALL AND NOT UPGRADINGPRODUCTCODE AND &amp;MainFeature = 3" />
      </InstallUISequence>
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="TianCaiSpaceHub">
        <!-- New file paths require new component GUIDs; keep them stable in later releases. -->
        <Component Id="TianCaiSpaceHubExecutable" Guid="{AF89396D-3CF1-48C8-817D-01AF68BB0F7F}">
          <File Id="TianCaiSpaceHubExe" Source="$(var.SourceDir)\TianCaiSpaceHub.exe" KeyPath="yes" />
        </Component>
        <!-- The protocol registry key is unchanged, so its component identity stays compatible. -->
        <Component Id="HubWebImportProtocol" Guid="{E62F8A91-CF58-4BCC-BDA4-D0C65BFEFB24}">
          <RegistryKey Root="HKLM" Key="Software\Classes\tiancaispacehub">
            <RegistryValue Type="string" Value="URL:TianCaiSpaceHub Import" />
            <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
            <RegistryValue Name="TianCaiSpaceHubOwner" Type="string" Value="&quot;[INSTALLFOLDER]TianCaiSpaceHub.exe&quot; import-url &quot;%1&quot;" />
            <RegistryKey Key="DefaultIcon">
              <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]TianCaiSpaceHub.exe&quot;,0" />
            </RegistryKey>
            <RegistryKey Key="shell\open\command">
              <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]TianCaiSpaceHub.exe&quot; import-url &quot;%1&quot;" />
            </RegistryKey>
          </RegistryKey>
        </Component>
        <Component Id="TianCaiSpaceHubReadme" Guid="{FAB77E9C-76F3-4AB1-A2FC-6C35D5B39755}">
          <File Id="ReadmeMd" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
        </Component>
        <Component Id="TianCaiSpaceHubReadmeEn" Guid="{2693D123-1FA6-410C-AB7E-5B71318D26AB}">
          <File Id="ReadmeEnMd" Source="$(var.SourceDir)\README.en.md" KeyPath="yes" />
        </Component>
        <Component Id="TianCaiSpaceHubConfigExample" Guid="{689018C1-C0BF-4877-AAA6-46367EC53506}">
          <File Id="ConfigExampleToml" Source="$(var.SourceDir)\config.example.toml" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TianCaiSpaceHub">
        <Component Id="TianCaiSpaceHubStartMenuShortcut" Guid="{71897EBB-DAFB-434E-B5D5-1547EBDF9004}">
          <Shortcut
            Id="TianCaiSpaceHubStartMenuShortcut"
            Name="TianCaiSpaceHub"
            Description="Open TianCaiSpaceHub"
            Target="[INSTALLFOLDER]TianCaiSpaceHub.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="TianCaiSpaceHubIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\TianCaiSpaceHub"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="TianCaiSpaceHubDesktopShortcut" Guid="{CD2C7DFE-1FEB-432D-B973-95E1B5F78D90}">
        <Shortcut
          Id="TianCaiSpaceHubDesktopShortcut"
          Name="TianCaiSpaceHub"
          Description="Open TianCaiSpaceHub"
          Target="[INSTALLFOLDER]TianCaiSpaceHub.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="TianCaiSpaceHubIcon" />
        <RegistryValue
          Root="HKCU"
          Key="Software\TianCaiSpaceHub"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="TianCaiSpaceHub" Level="1">
      <ComponentRef Id="TianCaiSpaceHubExecutable" />
      <ComponentRef Id="HubWebImportProtocol" />
      <ComponentRef Id="TianCaiSpaceHubReadme" />
      <ComponentRef Id="TianCaiSpaceHubReadmeEn" />
      <ComponentRef Id="TianCaiSpaceHubConfigExample" />
      <ComponentRef Id="TianCaiSpaceHubStartMenuShortcut" />
      <ComponentRef Id="TianCaiSpaceHubDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
