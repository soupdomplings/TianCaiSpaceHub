1 ICON "packaging/icons/AppIcon.ico"

1 VERSIONINFO
FILEVERSION HUB_VERSION_NUMBERS
PRODUCTVERSION HUB_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TianCaiSpaceHub\0"
            VALUE "FileDescription", "TianCaiSpaceHub\0"
            VALUE "FileVersion", HUB_VERSION_STRING
            VALUE "InternalName", "TianCaiSpaceHub\0"
            VALUE "OriginalFilename", "TianCaiSpaceHub.exe\0"
            VALUE "ProductName", "TianCaiSpaceHub\0"
            VALUE "ProductVersion", HUB_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
